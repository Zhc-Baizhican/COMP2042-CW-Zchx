<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="hackPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.HackMenuController">
    <stylesheets>
        <URL value="@styling.css" />
    </stylesheets>
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="settingsScroll" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox alignment="TOP_CENTER" spacing="10.0" styleClass="hackContent">
                    <children>
                        <Label id="title" text="HACKS" />
                        <Label styleClass="sectionTitle" text="Tick any combination — the rules stack" />
                        <VBox fx:id="hackList" maxWidth="520.0" spacing="6.0" />
                        <Button fx:id="btn_back" onAction="#handleBack" prefHeight="40.0" prefWidth="115.0" styleClass="menuButton" text="Back" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
