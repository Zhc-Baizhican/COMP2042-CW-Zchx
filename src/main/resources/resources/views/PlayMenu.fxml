<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="playPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.PlayMenuController">
    <stylesheets>
        <URL value="@styling.css" />
    </stylesheets>
    <children>
        <VBox alignment="CENTER" spacing="16.0" AnchorPane.bottomAnchor="22.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="22.0">
            <children>
                <Label id="title" text="CHOOSE DIFFICULTY" />
                <HBox fx:id="difficultyRow" alignment="CENTER" spacing="10.0" />
                <Label fx:id="description" maxWidth="470.0" styleClass="difficultyDescription" textAlignment="CENTER" wrapText="true" />
                <HBox alignment="CENTER" spacing="14.0">
                    <children>
                        <Button fx:id="btn_play" onAction="#handlePlay" prefHeight="49.0" prefWidth="190.0" styleClass="primaryButton" text="Play" />
                        <Button fx:id="btn_back" onAction="#handleBack" prefHeight="40.0" prefWidth="115.0" styleClass="menuButton" text="Back" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
