<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="achievementPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.AchievementController">
    <stylesheets>
        <URL value="@styling.css" />
    </stylesheets>
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="settingsScroll" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox alignment="TOP_CENTER" spacing="10.0" styleClass="achievementContent">
                    <children>
                        <Label id="title" text="BADGES" />
                        <Label fx:id="countLabel" styleClass="sectionTitle" text="0 of 0 unlocked" />
                        <VBox fx:id="badgeList" alignment="TOP_CENTER" maxWidth="520.0" spacing="6.0" />
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button fx:id="resetButton" managed="false" onAction="#handleReset" prefHeight="40.0" prefWidth="115.0" styleClass="menuButton" text="Reset" visible="false" />
                                <Button fx:id="btn_back" onAction="#handleBack" prefHeight="40.0" prefWidth="115.0" styleClass="menuButton" text="Back" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
