<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="settingsPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.SettingsController">
    <stylesheets>
        <URL value="@styling.css" />
    </stylesheets>
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="settingsScroll" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox alignment="TOP_CENTER" spacing="8.0">
                    <padding>
                        <Insets bottom="14.0" left="26.0" right="26.0" top="14.0" />
                    </padding>
                    <children>
                        <Label id="settingsTitle" text="SETTINGS" />
                        <Label styleClass="sectionTitle" text="SOUND" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label minWidth="92.0" styleClass="settingLabel" text="Sound" />
                                <CheckBox fx:id="soundCheck" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label minWidth="92.0" styleClass="settingLabel" text="Volume" />
                                <Slider fx:id="volumeSlider" blockIncrement="0.05" max="1.0" min="0.0" prefWidth="200.0" />
                                <Label fx:id="volumeValue" minWidth="48.0" styleClass="settingLabel" />
                            </children>
                        </HBox>
                        <Label styleClass="sectionTitle" text="SNAKE COLOUR  —  click a swatch" />
                        <HBox fx:id="skinRow" alignment="CENTER" spacing="10.0" />
                        <Label fx:id="skinName" styleClass="settingLabel" text="Current: Green" />
                        <Label styleClass="sectionTitle" text="THEME" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label minWidth="92.0" styleClass="settingLabel" text="Night mode" />
                                <CheckBox fx:id="darkThemeCheck" />
                            </children>
                        </HBox>
                        <Label styleClass="sectionTitle" text="WINDOW SIZE" />
                        <HBox fx:id="sizeRow" alignment="CENTER" spacing="10.0" />
                        <Label styleClass="sectionTitle" text="DEVELOPER" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label minWidth="92.0" styleClass="settingLabel" text="Dev mode" />
                                <CheckBox fx:id="devModeCheck" />
                            </children>
                        </HBox>
                        <Label styleClass="sectionTitle" text="CONTROLS  —  click a key to change it" />
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="170.0" styleClass="keyScroll" vbarPolicy="AS_NEEDED">
                            <content>
                                <VBox fx:id="keyRowBox" spacing="5.0" />
                            </content>
                        </ScrollPane>
                        <Label fx:id="keyHint" minHeight="16.0" styleClass="settingLabel" text="" />
                        <Button fx:id="btn_back" onAction="#handleBack" prefHeight="34.0" prefWidth="115.0" styleClass="menuButton" text="Back" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
